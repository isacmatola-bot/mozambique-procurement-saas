# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
APP_NAME="IFP Inhamizua Procurement SaaS"
DEFAULT_ORGANIZATION_NAME="Instituto de Formação de Professores de Inhamizua"

# Database: local Docker PostgreSQL or Supabase pooled connection string
DATABASE_URL=postgresql://postgres:changeme123@localhost:5432/mozambique_procurement

# Security
JWT_SECRET=change_this_to_a_very_long_random_secret_before_launch
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# OpenAI contract extraction. Leave blank to use deterministic demo extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Mozambique compliance defaults
VAT_RATE=0.17
BENEFICIAL_OWNERSHIP_THRESHOLD=60000000
LOCAL_CONTENT_MARGIN_WORKS=0.15
LOCAL_CONTENT_MARGIN_GOODS=0.20
INVOICE_RETENTION_YEARS=10
DEFAULT_CURRENCY=MZN
TIMEZONE=Africa/Maputo
