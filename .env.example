# === APPLICATION ===
NODE_ENV=development
PORT=3001
APP_NAME="Mozambique Procurement SaaS"
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# === DATABASE ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mozambique_procurement
DB_USER=postgres
DB_PASSWORD=changeme123
DB_POOL_MIN=2
DB_POOL_MAX=10

# === AUTHENTICATION ===
JWT_SECRET=your_super_secret_jwt_key_change_in_production_12345
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d
BCRYPT_ROUNDS=10

# === OAUTH2 (Optional) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# === FILE STORAGE ===
S3_BUCKET=mozambique-procurement
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=https://s3.amazonaws.com
MAX_FILE_SIZE=52428800
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# === EMAIL SERVICE ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@procurement-saas.mz
SENDGRID_API_KEY=

# === LOGGING ===
LOG_LEVEL=info
LOG_FORMAT=json

# === FEATURES ===
ENABLE_ELECTRONIC_SIGNATURES=true
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_AUDIT_LOGGING=true

# === COMPLIANCE SETTINGS ===
VAT_RATE=0.17
BENEFICIAL_OWNERSHIP_THRESHOLD=60000000
LOCAL_CONTENT_MARGIN_WORKS=0.15
LOCAL_CONTENT_MARGIN_GOODS=0.20
INVOICE_RETENTION_YEARS=10

# === MONITORING ===
SENTRY_DSN=

# === REDIS ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# === LOCALIZATION ===
TIMEZONE=Africa/Maputo
LOCALE=pt_MZ
DEFAULT_CURRENCY=MZN
